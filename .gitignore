# 환경 변수
.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# 로그 / 임시 파일
*.log
logs/
debug/

# 실행 리포트(reports/)는 일부러 커밋한다 — 집 PC 가 무슨 일을 했는지
# 클라우드 세션이 git pull 로 읽어야 하기 때문. logs/·debug/ 와 달리
# **요약만** 담고 메뉴 데이터·쿠키·토큰은 절대 넣지 않는다.
# (scripts/menu_report.py 가 생성 — 손으로 파일을 넣지 말 것)
!reports/
reports/*.tmp

# 브라우저 세션 프로필 (로그인 쿠키 등 민감정보 — 절대 커밋 금지)
.browser_profile/

# OS
.DS_Store

# 자동화(블로그): 개인 설정·세션·생성물은 올리지 않음
automation/config.yaml
automation/chrome_profile/
automation/posts/
automation/library/
automation/cron.log
# 로그인 세션·쿠키(민감정보) — 절대 커밋 금지
automation/naver_state.json
automation/login_status.txt

# 인스타: 구글/Buffer 인증 파일(민감정보) — 절대 커밋 금지
service_account.json
client_secret.json
token.json

# 로컬 샘플/테스트 산출물
sample_output/
sample/
sample_frames/

# 웹앱: 순위 추적 결과(생성 데이터)
webapp/rank_history.json
# 웹앱: 로그인 세션 서명키(기기별 · 민감정보) — 절대 커밋 금지
webapp/.flask_secret
# 직원용 서비스: 클라우드에 올릴 설정(Supabase 키 포함) — 절대 커밋 금지
service/.env
service/.env.production

# 인스타 릴스 런타임 산출물 (영상 원본·편집본)
automation/reels/
automation/reels_완성본/
.env.bak
.env.*.bak
# 날짜가 뒤에 붙은 백업(.env.bak.20260818)은 위 두 줄에 안 걸린다 —
# 실제로 git add -A 에 쓸려 들어가 GitHub 가 막았다(2026-08-21).
.env.bak*
.env.*.bak.*

# 발주 사이트 수집 원본 — 거래처 단가가 들어 있어 올리지 않는다(집 PC 로컬)
data/msfs_raw.json

# 블로그 사진함 — AI가 사진을 보고 적어 둔 기록과 변환본(각 PC에서 다시 만들면 됨)
data/blog_media_index.json
data/blog_media_cache/
data/blog_clips/
data/blog_used_log.json
data/blog_reactions.json
data/blog_quality.json
