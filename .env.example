# ==========================================================
# 베어글스 AI 비서 - 환경 변수 예시 (통합)
# 실제 값은 .env 에 채우세요 (.env 는 git 에 커밋되지 않습니다)
# 세 시스템(매출봇·블로그·인스타)이 공유하는 값은 한 번만 채우면 됩니다.
# ==========================================================

# --- 공통: AI ---
# 제미나이 무료 키(주력). 무료 한도는 **키마다 따로**라, 다른 구글 계정으로
# 하나 더 만들어(무료·카드 불필요: https://aistudio.google.com/apikey)
# _2 에 넣으면 상위 모델의 하루 한도가 두 배가 된다. 한도가 마르면 자동으로
# 다음 키로 넘어간다. _3, _4 … 로 계속 이어 붙일 수 있다.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
# 클로드(유료) — 답글 사다리의 예외적 보루로만 쓴다(무료가 다 말랐을 때).
# 내부용 작업(블로그·회의·소개글)은 유료를 아예 두드리지 않는다(2026-08-30).
# 크레딧이 마르면 ANTHROPIC_API_KEY_2 로 자동 전환(있을 때만).
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_2=


# --- 공통: Supabase ---
SUPABASE_URL=
SUPABASE_KEY=
# service_role(secret) 키 — 있으면 백엔드가 우선 사용(RLS 우회). 권장.
SUPABASE_SERVICE_KEY=

# ==========================================================
#  매출·리뷰 봇 전용
# ==========================================================
# --- 배달의민족 ---
BAEMIN_ID=
BAEMIN_PASSWORD=

# --- 쿠팡이츠 ---
COUPANG_ID=
COUPANG_PASSWORD=

# --- 브라우저 자동화 ---
# attach : scripts/launch_chrome.bat 로 띄운 Chrome(CDP)에 붙어 작업(권장)
# profile: 크롤러가 .browser_profile/ 로 직접 Chrome 실행 (무인 서버용)
BROWSER_MODE=attach
CDP_PORT=9222
BROWSER_PROFILE_DIR=
WRITE_DRY_RUN=true

# ==========================================================
#  인스타 파이프라인 전용
# ==========================================================
# 구글 드라이브 (OAuth 로그인 방식) — 아래 두 파일명은 그대로 두세요
GOOGLE_OAUTH_CLIENT_FILE=client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=token.json
# 촬영 원본을 올리는 "원본소재" 폴더 ID (이 폴더 아래 주제별 하위 폴더)
#   드라이브 경로: 오픈후 > 콘텐츠 생성 > 원본소재
#   사장님이 폰 갤러리 → 공유 → 드라이브 앱으로 주제 폴더에 올린다.
GOOGLE_DRIVE_FOLDER_ID=1cJf1C4C3LGAUqDdF9M8ckglPR0ViHBSw

# Buffer 새 API (인스타 발행용) — buffer.com → Settings → API → Create API Key
BUFFER_ACCESS_TOKEN=
# 채널 ID: 토큰 채운 뒤 get_instagram_id.bat 실행하면 자동으로 찾아줌
BUFFER_CHANNEL_ID=

# 폴링 주기(분) — 드라이브 확인 간격. 기본 5분
POLL_INTERVAL_MINUTES=5

# [7] 웹 파이프라인 완성본 저장 위치 (선택)
#     비워두면 프로젝트 폴더 안 '완성본/'. 구글 드라이브 폴더를 지정하면 자동 동기화됨.
#     예) PIPELINE_FINAL_DIR=C:\Users\사용자\Google Drive\...\콘텐츠 생성\완성본
PIPELINE_FINAL_DIR=

# --- 웹 파이프라인 접속 (선택) ---
# 폰/외부 접속을 열 때 잠금 코드. 설정하면 처음 접속 시 주소 뒤에 ?code=값 필요.
PIPELINE_ACCESS_CODE=
# 기본 0.0.0.0(같은 와이파이 접속 허용). PC에서만 쓰려면 127.0.0.1
PIPELINE_HOST=
PIPELINE_PORT=

# [8] 메타 그래프 API  ── 해시태그 리서치 + 내 계정 인사이트 (무료)
#     발급 절차: docs/meta_graph_setup.md  (그래프 API 탐색기 → 장기 토큰)
#     필요 권한: pages_show_list, pages_read_engagement, instagram_basic,
#               instagram_manage_insights, business_management
#     확인: python check_meta.py
META_ACCESS_TOKEN=
#     비워두면 토큰에서 자동으로 찾습니다 (check_meta.py 가 값을 알려줌)
IG_USER_ID=
