# ============================================================
# 베어글스 SNS 봇 설정 파일
# 각 줄의 = 뒤에 값을 붙여넣으세요. (= 앞뒤로 띄어쓰기 없이)
# 예)  ANTHROPIC_API_KEY=sk-ant-abcd1234...
# ============================================================

# [1] Claude API 키  ── 캡션 생성용
#     https://console.anthropic.com  →  왼쪽 API Keys  →  Create Key
ANTHROPIC_API_KEY=

# [2] 텔레그램  ── 기존 베어글스 비서 봇과 "똑같은" 값을 씁니다
#     기존 비서 프로젝트의 .env 파일에서 그대로 복사해 오세요
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# [3] Supabase  ── 기존 베어글스 비서와 "똑같은" DB
#     Supabase 대시보드  →  Settings  →  API
#     SUPABASE_URL = "Project URL",  SUPABASE_KEY = "service_role" 키(secret)
SUPABASE_URL=
SUPABASE_KEY=

# [4] 구글 드라이브 (OAuth 로그인 방식) ── 아래 두 파일 이름은 그대로 두세요
GOOGLE_OAUTH_CLIENT_FILE=client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=token.json
# "콘텐츠 생성" 폴더 ID (이 폴더 아래에 주제별 하위 폴더를 만들어 사용)
#   ※ 아래 값은 "오픈후" 폴더 ID입니다. "오픈후 > 콘텐츠 생성" 폴더를 열어
#     주소창의 folders/ 뒤 ID로 바꿔주세요.
GOOGLE_DRIVE_FOLDER_ID=1IaOWXU2UULMtjeIaob2YRUsiYinEmEbx

# [5] Buffer 새 API  ── 인스타그램 발행용
#     토큰: buffer.com 로그인  →  Settings  →  API  →  Create API Key
BUFFER_ACCESS_TOKEN=
#     채널 ID: 위 토큰을 먼저 채운 뒤 get_instagram_id.bat 을 더블클릭하면 자동으로 찾아줍니다
BUFFER_CHANNEL_ID=

# [6] 폴링 주기 (분) ── 몇 분마다 드라이브를 확인할지. 기본 5분
POLL_INTERVAL_MINUTES=5

# [7] 웹 파이프라인 완성본 저장 위치 (선택)
#     비워두면 프로젝트 폴더 안 '완성본/'. 구글 드라이브 폴더를 지정하면 자동 동기화됨.
#     예) PIPELINE_FINAL_DIR=C:\Users\사용자\Google Drive\...\콘텐츠 생성\완성본
PIPELINE_FINAL_DIR=

# --- 웹 파이프라인 접속 (선택) ---
# 폰/외부 접속을 열 때 잠금 코드. 설정하면 처음 접속 시 주소 뒤에 ?code=값 필요.
PIPELINE_ACCESS_CODE=
# 기본 0.0.0.0(같은 와이파이 접속 허용). PC에서만 쓰려면 127.0.0.1
PIPELINE_HOST=
PIPELINE_PORT=
