# ==========================================================
# 베어글스 카페 AI 비서 - 환경 변수 예시
# 실제 값은 .env 파일에 채워 넣으세요 (.env 는 git 에 커밋되지 않습니다)
# ==========================================================

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=
# service_role(secret) 키 — 있으면 백엔드가 우선 사용(RLS 우회). 권장.
SUPABASE_SERVICE_KEY=

# --- 배달의민족 (배민) ---
BAEMIN_ID=
BAEMIN_PASSWORD=

# --- 쿠팡이츠 ---
COUPANG_ID=
COUPANG_PASSWORD=

# --- 브라우저 자동화 ---
# attach : scripts/launch_chrome.bat 로 띄운 Chrome(CDP)에 붙어 새 탭에서 작업(권장)
# profile: 크롤러가 .browser_profile/ 로 직접 Chrome 실행 (무인 서버용)
BROWSER_MODE=attach
CDP_PORT=9222
BROWSER_PROFILE_DIR=
WRITE_DRY_RUN=true

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Anthropic / Claude (AI 비서용) ---
ANTHROPIC_API_KEY=
