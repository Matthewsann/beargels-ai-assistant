# Claude API
ANTHROPIC_API_KEY=

# 텔레그램 (기존 베어글스 비서 봇과 동일한 토큰 사용)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase (기존 베어글스 비서 프로젝트와 동일한 DB)
SUPABASE_URL=
SUPABASE_KEY=

# Google Drive (OAuth 로그인 방식)
# 구글 클라우드에서 받은 OAuth 클라이언트 JSON (데스크톱 앱)
GOOGLE_OAUTH_CLIENT_FILE=client_secret.json
# authorize_drive.py 실행 시 자동 생성되는 로그인 토큰
GOOGLE_OAUTH_TOKEN_FILE=token.json
GOOGLE_DRIVE_FOLDER_ID=

# Buffer
BUFFER_ACCESS_TOKEN=
INSTAGRAM_PROFILE_ID=

# 폴링 주기 (분, 기본 5분)
POLL_INTERVAL_MINUTES=5
